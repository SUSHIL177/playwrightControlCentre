{
  "name": "playwright-automation-control-center",
  "version": "1.3.2",
  "description": "Playwright Automation Control Center - AI-Powered Test Execution, Analytics, Failure Intelligence & Self-Healing Platform",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && tsc -p tsconfig.electron.json && electron .\"",
    "build": "tsc && tsc -p tsconfig.electron.json && vite build",
    "package:win": "npm run build && electron-builder --win --x64",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "lucide-react": "^0.454.0",
    "node-cron": "^3.0.3",
    "recharts": "^2.13.3",
    "sql.js": "^1.12.0",
    "tree-kill": "^1.2.2",
    "uuid": "^11.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.playwright.controlcenter",
    "productName": "Playwright Automation Control Center",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    }
  }
}
