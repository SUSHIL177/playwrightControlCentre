{
  "name": "playwright-automation-control-center",
  "version": "1.8.0",
  "description": "Playwright Automation Control Center - AI-Powered Test Execution, Analytics, Failure Intelligence & Self-Healing Platform (Desktop + hosted multi-user web)",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && tsc -p tsconfig.electron.json && electron .\"",
    "build": "tsc && tsc -p tsconfig.electron.json && vite build",
    "package:win": "npm run build && electron-builder --win --x64",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "verify:healing": "npm run build && node scripts/verify/healing-e2e.js",
    "verify:ui": "node scripts/verify/ui-smoke.js",
    "start:web": "node dist-electron/server/webServer.js",
    "build:web": "tsc && tsc -p tsconfig.electron.json && vite build"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "lucide-react": "^0.454.0",
    "node-cron": "^4.6.0",
    "recharts": "^3.11.1",
    "sql.js": "^1.12.0",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.49",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.playwright.controlcenter",
    "productName": "Playwright Automation Control Center",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    }
  }
}
